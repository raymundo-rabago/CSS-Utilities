# ==========================================
# Configuración de NPM para publicación
# ==========================================

# Registro principal de npm
registry=https://registry.npmjs.org/

# Acceso por defecto al publicar paquetes:
# - public  : para paquetes de acceso público (recomendado para paquetes gratuitos)
# - restricted : para paquetes privados (requiere cuenta npm Pro/Team/Org)
access=public

# Regla de versionado de lockfile:
# - false: actualiza package-lock.json sin preguntar (recomendado)
# - true : falla si package-lock.json requiere actualizar
# - only : solo actualiza package-lock.json, no instala dependencias
lockfile-version=3

# Evitar que npm agregue ^ (caret) por defecto al instalar dependencias
# Usa "~" para patch-only o comenta esta línea para el comportamiento por defecto
# save-prefix=~

# Instalar sólo versiones exactas (sin ^ ni ~)
# save-exact=true

# No ejecutar scripts postinstall de paquetes por seguridad
# (recomendado en proyectos con dependencias desconocidas)
# ignore-scripts=true

# Fondo de auditoría de seguridad (desactiva mensajes de funding)
fund=false

# Auditorías automáticas tras cada install
audit=true

# Color en salida de terminal
color=true

# Nivel de progreso (silenciado: silent, normal: notice)
# loglevel=notice

# ==========================================
# Para autenticación (descomenta y configura si usas token):
# Puedes generar un token en: https://www.npmjs.com/settings/<TU_USUARIO>/tokens
# Luego ejecuta: `npm login` o usa una de las opciones siguientes.
# ==========================================

# Opción 1 - Token de autenticación (recomendado para CI/CD):
# //registry.npmjs.org/:_authToken=${NPM_TOKEN}

# Opción 2 - Autenticación por usuario/contraseña (base64):
registry.npmjs.org/:username=r4ymundo_r4bago
registry.npmjs.org/:_password=4N4m4rt1n!
registry.npmjs.org/:email=rayinmundo@gmail.com
